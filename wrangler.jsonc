{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wedding-website",
  "main": "src/index.js",
  "compatibility_date": "2026-06-01",

  // Static files in /public are served by the Worker *after* the password check.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  // RSVP database. Create it with `npx wrangler d1 create wedding-rsvps`
  // and paste the database_id it prints below.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wedding-rsvps",
      "database_id": "65182e20-98e1-406b-af8a-51151aad25ea"
    }
  ],

  // Serve the site on the custom domain (the domain is already on Cloudflare).
  "routes": [
    { "pattern": "janeandthomas.com", "custom_domain": true },
    { "pattern": "www.janeandthomas.com", "custom_domain": true }
  ],

  "observability": { "enabled": true }

  // Secrets (never committed) — set with `npx wrangler secret put <NAME>`:
  //   SITE_PASSWORD   the guest password (checked case-insensitively, spaces ignored)
  //   ADMIN_PASSWORD  protects /admin/rsvps.csv
}
